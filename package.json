{
  "name": "generator-markdown-to-html",
  "version": "1.1.0",
  "description": "Markdown to HTML generator using unified/remark/rehype (TypeScript + tsup + Vitest)",
  "keywords": [
    "markdown",
    "html",
    "converter",
    "gfm",
    "remark",
    "rehype",
    "unified"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/smoke-test.sh",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLazyEmail/generator-markdown-to-html.git"
  },
  "bugs": {
    "url": "https://github.com/LLazyEmail/generator-markdown-to-html/issues"
  },
  "homepage": "https://github.com/LLazyEmail/generator-markdown-to-html#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.0",
    "unified-stream": "^3.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "tsup": "^8.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  },
  "author": "Vadim",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  }
}
